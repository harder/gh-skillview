class Skillview < Formula
  desc "Terminal UI and CLI for browsing and managing gh skill skills"
  homepage "https://github.com/harder/gh-skillview"
  version "{{VERSION}}"
  license "MIT"

  on_macos do
    odie "SkillView Homebrew packages currently support Apple Silicon only." unless Hardware::CPU.arm?
    url "{{URL_DARWIN_ARM64}}"
    sha256 "{{SHA_DARWIN_ARM64}}"
  end

  on_linux do
    odie "SkillView Homebrew packages currently support x86_64 Linux only." unless Hardware::CPU.intel?
    url "{{URL_LINUX_X64}}"
    sha256 "{{SHA_LINUX_X64}}"
  end

  def install
    bin.install "skillview" => "skillview"
  end

  test do
    assert_match "Terminal.Gui", shell_output("#{bin}/skillview --version")
  end
end
