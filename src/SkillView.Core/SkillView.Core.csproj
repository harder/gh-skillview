<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>SkillView</RootNamespace>
    <AssemblyName>SkillView.Core</AssemblyName>
    <!-- Keep its lock file consistent when either AOT host restores this
         referenced project with PublishAot propagated from the host. -->
    <PublishAot>true</PublishAot>
    <TerminalGuiVersion Condition="'$(TerminalGuiVersion)' == ''">2.5.0</TerminalGuiVersion>
    <TerminalGuiEditorVersion Condition="'$(TerminalGuiEditorVersion)' == ''">2.5.7</TerminalGuiEditorVersion>
    <!-- Terminal.Gui is centrally pinned here so CI can override it via
         MSBuild while the app host keeps the modern AOT-safe lifecycle and the
         gh extension's separate TG2 NoWarn review stays local to that project. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Terminal.Gui" Version="$(TerminalGuiVersion)" />
    <PackageReference Include="Terminal.Gui.Editor" Version="$(TerminalGuiEditorVersion)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkillView.Tests" />
    <InternalsVisibleTo Include="SkillView.IntegrationTests" />
  </ItemGroup>

</Project>
