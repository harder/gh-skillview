<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Keep every lock file valid for the native release/CI publish matrix. -->
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;osx-arm64</RuntimeIdentifiers>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>SkillView</RootNamespace>
    <Company>SkillView</Company>
    <Authors>Kevin Harder</Authors>
    <Product>SkillView</Product>
    <!-- Local/dev builds default to 1.0.0; the release workflow overrides this with
         -p:Version=<tag> so shipped binaries report the actual release version. -->
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <VersionCore>$(Version.Split('-')[0])</VersionCore>
    <AssemblyVersion>$(VersionCore).0</AssemblyVersion>
    <FileVersion>$(VersionCore).0</FileVersion>
    <NeutralLanguage>en-US</NeutralLanguage>
  </PropertyGroup>
</Project>
